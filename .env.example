# --- Used only locally by scripts/process_emails.py (never sent to Vercel) ---

# Zoho mailbox (dedicated inbox for school emails)
ZOHO_EMAIL=your-mailbox@zoho.com
ZOHO_APP_PASSWORD=your-zoho-app-specific-password
ZOHO_IMAP_HOST=imap.zoho.com

# Comma-separated list of senders to process. Each entry is either a domain
# (with or without a leading "@") or a full email address, e.g.:
# SCHOOL_SENDER=@kingsely.org,test@school.org,another-school.uk
SCHOOL_SENDER=@example-school.uk

# --- Shared between the local script and the Vercel deployment ---

# Upstash Redis (REST API, from the Vercel Marketplace integration)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Year group this deployment serves (v1 only supports one)
YEAR_GROUP=Y3

# --- Used only by the Vercel deployment ---

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Shared secret for /api/cron/* endpoints. Vercel automatically sends this as
# "Authorization: Bearer <CRON_SECRET>" on its own cron invocations; reuse the
# same value to manually trigger an endpoint (Authorization header or ?secret=...)
CRON_SECRET=choose-a-long-random-string
